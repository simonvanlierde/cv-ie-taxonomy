{
  "name": "cv-ie-taxonomy-viz",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive exploded-teardown map of the CV-in-Industrial-Ecology taxonomy (Paper 2, Table S1).",
  "license": "MIT AND CC-BY-4.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "gen:theme": "node scripts/gen-theme-css.ts",
    "check:theme": "node scripts/check-theme.ts",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.9",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
