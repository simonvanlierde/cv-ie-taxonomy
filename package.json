{
  "name": "cv-ie-taxonomy-viz",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive exploded-teardown map of the taxonomy in the review article \"Benchmarked, Rarely Field-Tested: Computer Vision for End-of-Life Product Data in Industrial Ecology\" [citation: forthcoming], Table S2.",
  "license": "MIT AND CC-BY-4.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:theme": "node scripts/check-theme.ts",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.2",
    "lefthook": "^2.1.16",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
