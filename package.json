{
  "name": "cv-ie-taxonomy-viz",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive exploded-teardown map of the CV-in-Industrial-Ecology taxonomy (Paper 2, Table S2).",
  "license": "MIT AND CC-BY-4.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "gen:theme": "node scripts/gen-theme-css.ts",
    "check:theme": "node scripts/check-theme.ts",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
